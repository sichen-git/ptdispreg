total <- 0
for(k in 1:(S-n+1)) {   # X_i >= 1
total <- total + sibuya_pmf(k, alpha) * convolve_sibuya(S - k, n - 1, alpha)
}
return(total)
}
# Exact alpha score
alpha_score <- function(S, alpha, lambda, N_max=20) {
score_sum <- 0
likelihood <- 0
for(n in 0:N_max) {
P_N <- dpois(n, lambda)
P_S_given_n <- convolve_sibuya(S, n, alpha)
likelihood <- likelihood + P_N * P_S_given_n
}
# Now compute score
for(n in 1:N_max) {  # n=0 contributes 0
P_N <- dpois(n, lambda)
P_S_given_n <- convolve_sibuya(S, n, alpha)
# Digamma sum over i=1..n
# Approx: replace sum_i log(X_i) by n * E[log(X)|sum S] is complicated
# Here exact: sum_{all combinations of X_i summing to S}
# For illustration: approximate with n * digamma(S/n - alpha) - n * digamma(1 - alpha) + n/alpha
# Warning: combinatorial exact sum is expensive for large S or n
score_n <- n * (1/alpha + digamma(S/n - alpha) - digamma(1 - alpha))
score_sum <- score_sum + P_N * P_S_given_n * score_n
}
return(score_sum / likelihood)
}
# Compute
U_alpha <- alpha_score(S, alpha, lambda, N_max=10)
U_alpha
cat("Exact/approx alpha-score for S =", S, ":", U_alpha, "\n")
library(ggplot2)
library(gsl)  # digamma function
# Parameters
alpha <- 0.5
lambda <- 1
S_vals <- 1:50
N_trunc <- c(30, 40, 50)  # truncation of Poisson sum
# Sibuya PMF
sibuya_pmf <- function(k, alpha) {
if(k < 1) return(0)
return(alpha * gamma(k - alpha) / (gamma(k + 1) * gamma(1 - alpha)))
}
# Convolution: sum of n Sibuya variables equals S (recursive, small S feasible)
convolve_sibuya <- function(S, n, alpha) {
if(n == 0) return(ifelse(S == 0, 1, 0))
if(n == 1) return(sibuya_pmf(S, alpha))
total <- 0
for(k in 1:(S-n+1)) {  # X_i >= 1
total <- total + sibuya_pmf(k, alpha) * convolve_sibuya(S - k, n - 1, alpha)
}
return(total)
}
# Compute exact alpha score for different truncations
score_list <- list()
for(trunc in N_trunc){
U_alpha <- numeric(length(S_vals))
for(i in 1:length(S_vals)){
S <- S_vals[i]
likelihood <- 0
score_sum <- 0
for(n in 1:trunc){
P_N <- dpois(n, lambda)
P_S_given_n <- convolve_sibuya(S, n, alpha)
likelihood <- likelihood + P_N * P_S_given_n
score_n <- n * (1/alpha + digamma(S/n - alpha) - digamma(1 - alpha))
score_sum <- score_sum + P_N * P_S_given_n * score_n
}
U_alpha[i] <- score_sum / likelihood
}
score_list[[as.character(trunc)]] <- data.frame(S=S_vals, U_alpha=U_alpha, N_trunc=as.factor(trunc))
}
