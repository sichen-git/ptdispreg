library(ggplot2)
library(gsl)  # for digamma function
# Parameters
alpha <- 0.5
lambda <- 1
S_vals <- 1:50
N_trunc <- c(5, 10, 20)  # truncation of Poisson sum
# Vectorized Sibuya PMF
sibuya_pmf <- function(k, alpha) {
k <- as.integer(k)
p <- ifelse(k < 1, 0, alpha * gamma(k - alpha) / (gamma(k + 1) * gamma(1 - alpha)))
return(p)
}
# Dynamic programming for convolution P(sum X_i = S | N = n)
convolve_sibuya_dp <- function(S_max, N_max, alpha) {
# dp[n, s] = P(sum of n X_i = s)
dp <- matrix(0, nrow = N_max + 1, ncol = S_max + 1)
dp[1, 1:S_max] <- sibuya_pmf(1:S_max, alpha)  # n=1 row
for(n in 2:N_max){
for(s in n:S_max){  # sum >= n because X_i >= 1
k_vals <- 1:(s - (n-1))
dp[n, s] <- sum(sibuya_pmf(k_vals, alpha) * dp[n-1, s - k_vals])
}
}
return(dp)  # rows = n, cols = S
}
# Compute alpha score for different truncations
score_list <- list()
for(trunc in N_trunc){
dp <- convolve_sibuya_dp(max(S_vals), trunc, alpha)
U_alpha <- numeric(length(S_vals))
for(i in 1:length(S_vals)){
S <- S_vals[i]
likelihood <- 0
score_sum <- 0
for(n in 1:trunc){
P_N <- dpois(n, lambda)
P_S_given_n <- dp[n, S]
likelihood <- likelihood + P_N * P_S_given_n
# Approximate sum_i derivative by n * digamma(S/n - alpha)
score_n <- n * (1/alpha + digamma(S/n - alpha) - digamma(1 - alpha))
score_sum <- score_sum + P_N * P_S_given_n * score_n
}
U_alpha[i] <- score_sum / likelihood
}
score_list[[as.character(trunc)]] <- data.frame(S=S_vals, U_alpha=U_alpha, N_trunc=as.factor(trunc))
}
# Combine for plotting
plot_df <- do.call(rbind, score_list)
plot_df$logS <- log(plot_df$S)
# Plot
ggplot(plot_df, aes(x=logS, y=U_alpha, color=N_trunc)) +
geom_line(size=1.2) +
theme_minimal() +
labs(title="Exact α-Score vs log(S) for Discrete Stable",
x="log(S)",
y="Alpha Score U_alpha",
color="N truncation")
plot_df
